# Dependencies and frontend output
/node_modules/
/dist/
/coverage/

# Rust and Tauri build output
/src-tauri/target/
/src-tauri/target-*/
/src-tauri/gen/schemas/

# Sidecars are downloaded from pinned releases by scripts/download-sidecars.ps1
/src-tauri/binaries/*
!/src-tauri/binaries/README.md

# Installers and packaged artifacts belong in GitHub Releases
*.msi
*-setup.exe
*.appx
*.appxbundle

# Local configuration, credentials, and logs
.env
.env.*
!.env.example
*.log
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor and operating-system files
/.idea/
/.vscode/
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.tmp
*.temp
*.bak

# Local run scripts and development artifacts
/run-miles.bat

# Playwright MCP captures (may contain page content)
/.playwright-mcp/

# Design prototypes and screenshots
/prototype-*.html
/prototype-*.png
/color-*.png
/theme-*.png

